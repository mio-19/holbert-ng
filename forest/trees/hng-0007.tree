  P.Q.
    (P && Q)
    ----------- &&comm
    (Q && P)

    P. Q. H |: elim (--&&E H P Q (Q && P)) {
        1 2 |: by (--&&I Q P) {
            |: by (2) {}
            |: by (1) {}}}
